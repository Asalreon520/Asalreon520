Ejecute una consulta contra su vista para asegurarse de que funciona

CREATE VIEW TopCustomers AS
SELECT companyname, SUM(unitprice * quantity) AS "Total Sales"
FROM customers C
JOIN orders O ON C.customerid = O.customerid
JOIN orderdetails D ON O.orderid = D.orderid
GROUP BY companyname
ORDER BY 2 DESC
LIMIT 5;

Eliminar la Vista si Existe

DROP VIEW IF EXISTS TopCustomers;

Crear la Vista con la Expresión CASE

CREATE VIEW TopCustomers AS
SELECT companyname, 
       SUM(unitprice * quantity) AS "Total Sales",
       CASE 
           WHEN SUM(unitprice * quantity) < 60000 THEN 'Enfoque en las necesidades'
           WHEN SUM(unitprice * quantity) >= 60000 AND SUM(unitprice * quantity) < 115000 THEN 'Promedio'
           ELSE 'Sobresaliente'
       END AS "Evaluación"
FROM customers C
JOIN orders O ON C.customerid = O.customerid
JOIN orderdetails D ON O.orderid = D.orderid
GROUP BY companyname
ORDER BY 2 DESC
LIMIT 5;

Verificar la Vista

SELECT * FROM TopCustomers;


