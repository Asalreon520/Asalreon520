import socket

# Crear un socket
mysock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

# Conectar al servidor
mysock.connect(('data.pr4e.org', 80))

# Enviar la solicitud GET para la nueva URL
cmd = 'GET /intro-short.txt HTTP/1.0\r\nHost: data.pr4e.org\r\n\r\n'.encode()
mysock.send(cmd)

# Leer la respuesta
response = b""
while True:
    data = mysock.recv(512)
    if len(data) < 1:
        break
    response += data

# Cerrar el socket
mysock.close()

# Convertir la respuesta en texto
response = response.decode()

# Imprimir los encabezados y los datos
headers, body = response.split("\r\n\r\n", 1)

# Imprimir encabezados
print("Headers:")
print(headers)

# Imprimir el cuerpo (contenido de la página)
print("\nBody:")
print(body)

# Separar los encabezados y extraer la información necesaria
header_lines = headers.split("\r\n")
last_modified = None
etag = None
content_length = None
cache_control = None
content_type = None

for line in header_lines:
    if line.lower().startswith("last-modified:"):
        last_modified = line.split(":")[1].strip()
    elif line.lower().startswith("etag:"):
        etag = line.split(":")[1].strip()
    elif line.lower().startswith("content-length:"):
        content_length = line.split(":")[1].strip()
    elif line.lower().startswith("cache-control:"):
        cache_control = line.split(":")[1].strip()
    elif line.lower().startswith("content-type:"):
        content_type = line.split(":")[1].strip()

# Imprimir los valores de los encabezados
print(f"Last-Modified: {last_modified}")
print(f"ETag: {etag}")
print(f"Content-Length: {content_length}")
print(f"Cache-Control: {cache_control}")
print(f"Content-Type: {content_type}")


