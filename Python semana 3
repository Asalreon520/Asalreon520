import urllib.request
from bs4 import BeautifulSoup

# Función para seguir los enlaces
def follow_links(url, count, position):
    for _ in range(count):
        print(f"Retrieving: {url}")
        html = urllib.request.urlopen(url).read()
        soup = BeautifulSoup(html, 'html.parser')
        
        # Encontrar todos los enlaces <a> en la página
        tags = soup.find_all('a')
        
        # Obtener el enlace en la posición especificada (position-1, ya que es 1-indexed)
        url = tags[position - 1].get('href', None)
    
    # Retornar el último nombre en la secuencia
    last_name = url.split('_')[-1].split('.')[0]
    return last_name

# Entrada del usuario
url = input("Enter URL: ")
count = int(input("Enter count: "))
position = int(input("Enter position: "))

# Obtener el último nombre en la secuencia
last_name = follow_links(url, count, position)

# Imprimir la respuesta
print(f"The answer to the assignment for this execution is \"{last_name}\".")

