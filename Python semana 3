import urllib.request
import xml.etree.ElementTree as ET

# Pedir la URL
url = input("Enter location: ")

# Descargar el contenido del XML desde la URL
print(f"Retrieving {url}")
xml_data = urllib.request.urlopen(url).read()

# Mostrar la longitud de los datos recibidos
print(f"Retrieved {len(xml_data)} characters")

# Parsear el XML
tree = ET.fromstring(xml_data)

# Buscar todos los elementos 'count' en el XML
counts = tree.findall('.//count')

# Inicializar la variable para la suma
total = 0

# Contar la cantidad de elementos y sumar sus valores
for count in counts:
    total += int(count.text)

# Mostrar el número de comentarios y la suma total
print(f"Count: {len(counts)}")
print(f"Sum: {total}")

