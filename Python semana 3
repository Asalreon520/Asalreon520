import re
import urllib.request

# URL del archivo de datos
url = 'http://py4e-data.dr-chuck.net/regex_sum_2167008.txt'

# Descargar el archivo
response = urllib.request.urlopen(url)
file_data = response.read().decode()

# Encontrar todos los números en el texto
numbers = re.findall('[0-9]+', file_data)

# Convertir los números a enteros y sumarlos
total_sum = sum(map(int, numbers))

# Mostrar el resultado
print('Sum:', total_sum)

