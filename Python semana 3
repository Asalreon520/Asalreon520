from urllib.request import urlopen
from bs4 import BeautifulSoup
import ssl

# Ignorar errores de certificado SSL
ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

# Solicitar la URL al usuario
url = input('Enter - ')
html = urlopen(url, context=ctx).read()
soup = BeautifulSoup(html, "html.parser")

# Encontrar todas las etiquetas <span> con la clase "comments"
tags = soup.find_all('span', class_='comments')

# Inicializar una variable para la suma
total = 0

# Iterar sobre todas las etiquetas <span> y sumar sus valores
for tag in tags:
    # Asegurarse de que el texto sea un número
    try:
        total += int(tag.text)
    except ValueError:
        continue  # Si no es un número, ignorar

# Mostrar el número total de etiquetas y la suma
print('Count', len(tags))
print('Sum', total)


