SELECT
    TO_CHAR(DATE_TRUNC('month', o.orderdate), 'FMMonth') AS month_name,
    COUNT(o.orderid) AS total_orders
FROM orders o
JOIN customers c ON o.customerid = c.customerid
WHERE EXTRACT(YEAR FROM o.orderdate) = 2004
  AND c.companyname = 'ClassicModels'
GROUP BY DATE_TRUNC('month', o.orderdate)
ORDER BY total_orders DESC
LIMIT 1;

