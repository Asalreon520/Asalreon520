#6.5 Write code using find() and string slicing (see section 6.10) to extract the number at the end of the line below. Convert the extracted value to a floating point number and print it out.

text = "X-DSPAM-Confidence:    0.8475"
# Usamos find() para encontrar la posición de los dos puntos
pos = text.find(':')
# Realizamos el slicing para extraer el número que sigue a los dos puntos
number_str = text[pos+1:].strip()
# Convertimos el número extraído a un valor flotante
number = float(number_str)
# Imprimimos el número flotante
print(number)

#0.8475
